generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status{
  CONFIRMADO
  CANCELADO
  FINALIZADO
}
enum Gender {
  MASCULINO
  FEMININO
  OUTRO
}
enum Type{
  ADMINISTRADOR
  PACIENTE
  PROFISSIONAL
}
model Usuario{
  id Int @id @default(autoincrement())
  email String @unique
  tipo Type
  senha String

  profissionais Profissional[]
  pacientes       Paciente[]
  depoimento   Depoimento[]
}

model Profissional{
  id Int @id @default(autoincrement())
  nome String
  matricula_profissional String
  foto_perfil String?
  quant_atend_gratis Int
  faixa_etaria String
  cidade String
  estado String
  genero Gender
  idade Int
  usuarioId Int

  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  atendimento Atendimento[]
  evolucoes Evolucao_clinica[]

}

model Paciente{
  id Int @id @default(autoincrement())
  nome String
  genero Gender
  data_nasc DateTime 
  motivo_terapia String
  medicamentos String
  historico_familiar String
  principal_queixa String
  usuarioId Int

  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  evolucoes Evolucao_clinica[]
  atendimento Atendimento[]

}

model Evolucao_clinica{
  id Int @id @default(autoincrement())
  data DateTime
  relato_atendimento String
  ajustes_tratamento String
  pacienteId Int
  profissionalId Int?
  
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  profissional Profissional? @relation(fields: [profissionalId], references: [id])

}

model Atendimento {
  id Int @id @default(autoincrement())
  data DateTime
  status Status
  pacienteId Int
  profissionalId Int

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  profissional Profissional? @relation(fields: [profissionalId], references: [id])
  
 
}

model Grupo_apoio{
  id Int @id @default(autoincrement())
  link String
  descricao String
}

model Depoimento{
  id Int @id @default(autoincrement())
  texto String
  data  DateTime @default(now())
  usuarioId Int

  usuario     Usuario   @relation(fields: [usuarioId], references: [id])

}